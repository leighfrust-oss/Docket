{
  "name": "docket-app",
  "version": "1.0.2",
  "description": "Docket - documents, status board, document register and reports (local)",
  "main": "main.js",
  "author": "Docket",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.docket.desktop",
    "productName": "Docket",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "leighfrust-oss",
        "repo": "docket"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
